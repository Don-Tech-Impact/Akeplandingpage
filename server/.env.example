PORT=8787
NODE_ENV=development

# Comma-separated allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4179,http://127.0.0.1:4179,https://landing.akepapp.com,https://www.akepapp.com,https://dash.akepapp.com

# ── Resend ─────────────────────────────────────────────────────────────────────
# Create a key at: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here

# Must be on a domain verified in Resend
# https://resend.com/domains (verify akepapp.com)
FROM_EMAIL=no-reply@akepapp.com

# Where admin/internal submission notifications are delivered
NOTIFY_TO=info@akepapp.com

# ── Email content links ───────────────────────────────────────────────────────
AKEP_LINKEDIN_URL=https://linkedin.com/company/akepapp
AKEP_TWITTER_URL=https://twitter.com/akepapp
SUPPORT_URL=https://akepapp.com/support
