PORT=8787
NODE_ENV=development

# Comma-separated allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://landing.akepapp.com,https://www.akepapp.com,https://dash.akepapp.com

# ── SendGrid ──────────────────────────────────────────────────────────────────
# Create a key at: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# Optional: segment waitlist signups into a specific Contact List
# SendGrid → Marketing → Contacts → Lists → copy the List ID
SENDGRID_WAITLIST_LIST_ID=

# Must be a verified sender in your SendGrid account
# https://app.sendgrid.com/settings/sender_auth
FROM_EMAIL=no-reply@akepapp.com

# Where admin/internal submission notifications are delivered
NOTIFY_TO=info@akepapp.com

# ── Email content links ───────────────────────────────────────────────────────
AKEP_LINKEDIN_URL=https://linkedin.com/company/akepapp
AKEP_TWITTER_URL=https://twitter.com/akepapp
SUPPORT_URL=https://akepapp.com/support
